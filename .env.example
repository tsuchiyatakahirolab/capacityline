# Required only for opt-in live calls. Never expose this value to the browser.
# Public deployment origin used for Open Graph and social preview URLs.
NEXT_PUBLIC_APP_URL=https://capacityline.example.com

CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Optional public URL for finalized CALL-E result events.
CALLE_WEBHOOK_URL=

# Optional comma-separated E.164 allow-list. If set, live calls are refused for
# every number outside the list. Recommended for demos and judge testing.
CALLE_ALLOWED_NUMBERS=
