# Required only for opt-in live calls. Never expose this value to the browser.
# Public deployment origin used for Open Graph and social preview URLs.
NEXT_PUBLIC_APP_URL=https://capacityline.example.com

CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Optional public URL for finalized CALL-E result events.
CALLE_WEBHOOK_URL=

# Required for live mode: comma-separated consenting E.164 recipients. Live calls
# fail closed when this is empty. The public deployment intentionally leaves it empty.
CALLE_ALLOWED_NUMBERS=

# Paid Private Pilot billing. Keep these server-side. Live calls fail closed until
# Checkout is ready, unless ALLOW_UNBILLED_LIVE_CALLS is explicitly set to true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PILOT_PRICE_ID=

# At least 32 random characters, used to sign the httpOnly billing entitlement.
BILLING_SESSION_SECRET=

# Human-readable copy only; Stripe remains the source of truth for the charged price.
PILOT_PRICE_LABEL=Scoped monthly pilot

# Emergency/internal override only. Never enable this on the public deployment.
ALLOW_UNBILLED_LIVE_CALLS=false
